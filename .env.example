# Copy this file to .env, then paste each key right after its "=" sign, without spaces or quotes.
# .env is ignored by Git: never commit it, never paste a key in an issue, a chat or a commit.
# Both keys are optional: without them, the collector works with CISA and CERT-FR.

# Mistral: press articles read by an AI (phase 2), and the CISA texts translated into French.
MISTRAL_API_KEY=

# ransomware.live PRO API: ransomware claims against organisations in France.
RANSOMWARE_LIVE_API_KEY=
