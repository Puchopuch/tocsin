# Copy this file to .env, then paste each key right after its "=" sign, without spaces or quotes.
# .env is ignored by Git. Never paste a key in a conversation.

# Mistral, for phase 2 (press articles read by AI). Not needed for phase 1.
MISTRAL_API_KEY=

# ransomware.live PRO API, for the ransomware claims (phase 1) and press-cited attacks (phase 2).
RANSOMWARE_LIVE_API_KEY=
